#!/bin/sh
# 分支规则：禁止直接推送 main / master（详见 docs/BRANCH-RULES.md）
remote="$1"
blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "[分支规则] 禁止直接推送 $remote_ref 到 '$remote'。" >&2
      echo "  请推送临时分支（如 fix/xxx）并通过 PR 合入 main。" >&2
      blocked=1
      ;;
  esac
done
exit "$blocked"

